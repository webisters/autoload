{
    "name": "webisters/autoload",
    "description": "Webisters Autoload Library",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "autoload",
        "autoloader",
        "loader",
        "locator",
        "file-locator",
        "class-locator"
    ],
    "authors": [
        {
            "name": "Hafiz Muhammad Moaz",
            "email": "hafizmoazkhalid@gmail.com",
            "homepage": "https://github.com/HafizMMoaz"
        }
    ],
    "homepage": "https://webisters.com/packages/autoload",
    "support": {
        "email": "support@webisters.com",
        "issues": "https://github.com/webisters/autoload/issues",
        "forum": "https://github.com/webisters/forum",
        "source": "https://github.com/webisters/autoload",
        "docs": "https://webisters.com"
    },
    "funding": [
        {
            "type": "Webisters Sponsor",
            "url": "https://webisters.com/sponsor"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "webisters/debug": "*"
    },
    "require-dev": {
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "webisters/coding-standard": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Framework\\Autoload\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Autoload\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse"
    }
}
